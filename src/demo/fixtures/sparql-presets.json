 {
  "label": "All eligibility rules",
  "query": "PREFIX transport: <https://transport.example.nl/ontology#>\nSELECT ?rule ?title ?description ?credentialType ?order\nWHERE {\n  ?rule a transport:EligibilityRule ;\n        transport:title ?title ;\n        transport:description ?description ;\n        transport:credentialType ?credentialType ;\n        transport:order ?order .\n}\nORDER BY ?order",
  "result": {
   "head": {
    "vars": [
     "rule",
     "title",
     "description",
     "credentialType",
     "order"
    ]
   },
